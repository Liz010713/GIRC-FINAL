classDiagram
  namespace GIRC {
    class EstadoProducto {
      <<enumeration>>
      DISPONIBLE
      CRITICO
      AGOTADO
    }
    class EstadoPedido {
      <<enumeration>>
      PENDIENTE
      CONFIRMADO
      CANCELADO
    }
    class Producto {
      -Long id
      -String sku
      -String nombreProducto
      -BigDecimal precioUnitario
      -Integer stockActual
      -Integer stockMinimo
      -EstadoProducto estado
    }
    class Pedido {
      -Long id
      -String codigoOrden
      -Long idUsuario
      -String claveIdempotencia
      -BigDecimal totalNeto
      -EstadoPedido estado
      -OffsetDateTime fechaCreacion
    }
    class DetallePedido {
      -Long id
      -Integer cantidadSolicitada
      -BigDecimal precioUnitario
      -BigDecimal subtotal
    }
    class PedidoServiceImpl {
      +crearPedido(CrearPedidoRequest request) Pedido
      -calcularEstadoProducto(Producto producto) EstadoProducto
    }
  }
  Pedido "1" *-- "0..*" DetallePedido : detalles
  DetallePedido "0..*" --> "1" Producto : producto
  Producto --> EstadoProducto : estado
  Pedido --> EstadoPedido : estado
  PedidoServiceImpl ..> Pedido : crea
  PedidoServiceImpl ..> Producto : actualiza stock
  note for Pedido "idUsuario es escalar. La API exige al menos un ítem."
