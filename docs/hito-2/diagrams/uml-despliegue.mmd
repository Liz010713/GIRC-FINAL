      front -->|HTTP backend:8080| api
      api -->|JDBC db:5432| db
      db --- vol
    end
    web -->|HTTP :80| front
  end

  subgraph production["Producción · topología propuesta"]
    direction LR
    remote["«device» Equipo del operador<br/>Navegador con SPA React"]
    subgraph vps["«node» VPS · host Docker"]
      proxy["«container» Frontend Nginx<br/>Proxy inverso y terminación TLS"]
      subgraph private["Red privada de aplicación"]
        service["«container» API Spring Boot"]
        pg["«container» PostgreSQL<br/>Volumen persistente"]
