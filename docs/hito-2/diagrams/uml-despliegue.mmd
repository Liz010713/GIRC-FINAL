flowchart TB
  subgraph local["Entorno local · implementado en Docker Compose"]
    direction LR
    web["«device» Equipo del operador<br/>Navegador con SPA React"]
    subgraph host["«node» Host Docker Compose"]
      front["«container» girc-frontend<br/>Nginx · host 80 → 80"]
      api["«container» girc-backend<br/>JRE 21 + Spring Boot · host 8080 → 8080"]
      db["«container» girc-db<br/>PostgreSQL 16 · host 5432 → 5432"]
