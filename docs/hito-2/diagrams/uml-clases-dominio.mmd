classDiagram
  namespace GIRC {
    class Producto {
      -Long id
      -String sku
      -String nombreProducto
      -BigDecimal precioUnitario
      -Integer stockActual
      -Integer stockMinimo
      -String estado
    }
    class Pedido {
      -Long id
      -String codigoOrden
      -Long idUsuario
      -String claveIdempotencia
      -BigDecimal totalNeto
      -String estado
      -OffsetDateTime fechaCreacion
    }
    class DetallePedido {
      -Long id
      -Integer cantidadSolicitada
      -BigDecimal precioUnitario
      -BigDecimal subtotal
    }
    class PedidoServiceImpl {
      +crearPedido(CrearPedidoRequest request) Pedido
      -calcularEstadoProducto(Producto producto) String
    }
  }
  Pedido "1" *-- "0..*" DetallePedido : detalles
  DetallePedido "0..*" --> "1" Producto : producto
  PedidoServiceImpl ..> Pedido : crea
  PedidoServiceImpl ..> Producto : actualiza stock
  note for Pedido "idUsuario es escalar. La API exige al menos un ítem."
